{
  "name": "@merra/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run validate && next dev",
    "build": "npm run validate && next build",
    "build:sites": "npm run validate && SITES_BUILD=1 opennextjs-cloudflare build && wrangler deploy --dry-run --outdir .worker-dist",
    "check": "npm run validate && next typegen && tsc --noEmit",
    "check:sites": "npm run validate && SITES_BUILD=1 next typegen && tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22"
  }
}
