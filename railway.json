{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "site/Dockerfile",
    "watchPatterns": [
      "/site/**",
      "/docs/devlog/**",
      "/docs/newsletter/**",
      "/golden/**",
      "/scenarios/**",
      "/railway.json"
    ]
  },
  "deploy": {
    "healthcheckPath": "/",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
